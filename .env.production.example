# Place real values in Railway Variables; do not commit populated copies.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306
DJANGO_MEDIA_ROOT=/data/media

# Private iDICE review link: https://vanaraoncoscan.cyou/access/<IDICE_ACCESS_CODE>/
# Leave unset to switch the link off. Optional expiry date (YYYY-MM-DD, last valid day).
IDICE_ACCESS_CODE=
IDICE_ACCESS_EXPIRES=
